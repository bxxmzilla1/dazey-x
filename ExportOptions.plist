<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  method:
	    development  - install on devices registered to your team (works with a free Apple ID)
	    ad-hoc       - install on registered devices without Xcode (paid account)
	    app-store    - upload to App Store Connect / TestFlight (paid account)
	  Xcode 15.3+ also accepts the new names: debugging / release-testing / app-store-connect.
	  build_ipa.sh can override this with: ./build_ipa.sh --method ad-hoc
	-->
	<key>method</key>
	<string>development</string>
	<!-- <string>ad-hoc</string> -->
	<!-- <string>app-store</string> -->

	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Replaced at build time with DEVELOPMENT_TEAM from build_ipa.sh -->
	<key>teamID</key>
	<string>YOUR_TEAM_ID</string>

	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
